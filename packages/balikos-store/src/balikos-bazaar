#!/bin/sh
# Launch Bazaar natively if installed, otherwise through Flatpak.
set -eu
if command -v bazaar >/dev/null 2>&1; then
    exec bazaar "$@"
fi
if command -v flatpak >/dev/null 2>&1; then
    exec flatpak run io.github.kolunmi.Bazaar "$@"
fi
printf 'Bazaar bulunamadı. flatpak install flathub io.github.kolunmi.Bazaar\n' >&2
exit 1
