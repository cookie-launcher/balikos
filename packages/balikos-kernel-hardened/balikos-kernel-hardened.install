#!/bin/sh
set -eu
find_kver() {
    for mod in /usr/lib/modules/*; do
        [ -f "$mod/pkgbase" ] || continue
        if [ "$(cat "$mod/pkgbase")" = "balikos-kernel-hardened" ]; then
            printf '%s\n' "${mod##*/}"
            return 0
        fi
    done
    return 1
}
post_install() {
    kver="$(find_kver)" || return 0
    install -Dm644 "/usr/lib/modules/${kver}/vmlinuz" /boot/vmlinuz-balikos-kernel-hardened
    if command -v mkinitcpio >/dev/null 2>&1; then mkinitcpio -p balikos-kernel-hardened || true; fi
}
post_upgrade() { post_install; }
