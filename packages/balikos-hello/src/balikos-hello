#!/usr/bin/env python3
"""BalıkOS welcome application."""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gio, Gtk  # noqa: E402

RELEASE_FILE = Path("/etc/balikos-release")


def release_info() -> tuple[str, str]:
    version = "1.0"
    name = "BalıkOS"
    try:
        for line in RELEASE_FILE.read_text(encoding="utf-8").splitlines():
            if line.startswith("VERSION="):
                version = line.split("=", 1)[1].strip().strip('"')
            elif line.startswith("RELEASE_NAME="):
                name = line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return version, name


def launch(argv: list[str]) -> None:
    try:
        subprocess.Popen(argv, start_new_session=True)
    except OSError:
        pass


class HelloWindow(Gtk.ApplicationWindow):
    def __init__(self, app: Gtk.Application) -> None:
        super().__init__(application=app, title="BalıkOS")
        self.set_default_size(720, 480)
        self.set_resizable(False)
        version, name = release_info()

        header = Gtk.HeaderBar()
        header.set_title_widget(Gtk.Label(label=name))
        self.set_titlebar(header)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        box.set_margin_top(48)
        box.set_margin_bottom(48)
        box.set_margin_start(48)
        box.set_margin_end(48)
        self.set_child(box)

        logo = Gtk.Picture.new_for_filename("/usr/share/pixmaps/balikos-logo.png")
        logo.set_can_shrink(True)
        logo.set_size_request(160, 160)
        logo.set_halign(Gtk.Align.CENTER)
        box.append(logo)

        title = Gtk.Label()
        title.set_markup("<span size='xx-large' weight='bold'>BalıkOS</span>")
        box.append(title)

        subtitle = Gtk.Label(label=f"Sürüm {version} · BalıkOS'a hoş geldiniz")
        subtitle.add_css_class("dim-label")
        box.append(subtitle)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        actions.set_halign(Gtk.Align.CENTER)
        box.append(actions)

        update = Gtk.Button(label="Sistem Güncelle")
        update.connect("clicked", lambda *_: launch(["pkexec", "balikos-updater", "--check"]))
        actions.append(update)

        store = Gtk.Button(label="BalıkOS Mağaza")
        store.connect("clicked", lambda *_: launch(["balikos-store"]))
        actions.append(store)

        settings = Gtk.Button(label="Ayarlar")
        settings.connect("clicked", lambda *_: launch(["gnome-control-center"]))
        actions.append(settings)

        links = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        links.set_halign(Gtk.Align.CENTER)
        box.append(links)

        website = Gtk.LinkButton(uri="https://balikos.org", label="balikos.org")
        links.append(website)
        docs = Gtk.LinkButton(uri="https://balikos.org/docs/", label="Belgeler")
        links.append(docs)
        issues = Gtk.LinkButton(uri="https://balikos.org/issues/", label="Sorun bildir")
        links.append(issues)

        about = Gtk.Button(label="Hakkında")
        about.connect("clicked", self.show_about)
        box.append(about)


    def show_about(self, *_args: object) -> None:
        version, name = release_info()
        dialog = Gtk.AboutDialog(transient_for=self, modal=True)
        dialog.set_program_name(name)
        dialog.set_version(version)
        dialog.set_website("https://balikos.org")
        dialog.set_website_label("balikos.org")
        dialog.set_logo_icon_name("balikos-logo")
        dialog.set_comments("BalıkOS canlı masaüstü ve kurulum ortamı")
        dialog.set_license_type(Gtk.License.MIT_X11)
        dialog.present()


class HelloApp(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id="org.balikos.Hello", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self) -> None:
        window = self.get_active_window()
        if window is None:
            window = HelloWindow(self)
        window.present()


def main() -> int:
    app = HelloApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
